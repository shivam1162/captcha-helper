<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black_bg"
    android:padding="24dp">

    <!-- Cat Logo -->
    <ImageView
        android:id="@+id/ivCat"
        android:layout_width="115dp"
        android:layout_height="115dp"
        android:src="@drawable/cat"
        android:contentDescription="Cat Logo"
        android:layout_marginBottom="24dp" />

    <!-- Main Heading -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_main"
        android:textColor="@color/pure_white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="32dp" />

    <!-- Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeColor="@color/crimson_red"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_inactive"
                android:textColor="@color/crimson_red"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableService"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_enable"
                android:textColor="@color/pure_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/crimson_red" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
